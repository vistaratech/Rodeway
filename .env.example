# ╔══════════════════════════════════════════════════════════════╗
# ║                   RODEWAY — Environment Config              ║
# ║         AI-Enhanced AR Navigation & Smart BLE Indicator     ║
# ╚══════════════════════════════════════════════════════════════╝
# 
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Google Maps & Navigation APIs ────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── ESP32 BLE Configuration ─────────────────────────────────
BLE_SERVICE_UUID=4fafc201-1fb5-459e-8fcc-c5c9c331914b
BLE_CHARACTERISTIC_UUID=beb5483e-36e1-4688-b7f5-ea07361b26a8
BLE_DEVICE_NAME=ESP32 Rodeway

# ─── ESP32 Hardware Pin Configuration ────────────────────────
ESP32_PIN_LEFT_RELAY=2
ESP32_PIN_RIGHT_RELAY=3
ESP32_RELAY_ACTIVE_LOW=true

# ─── Navigation Configuration ────────────────────────────────
TARGET_LANE_LIMIT=4
BLE_TRIGGER_DISTANCE_METERS=120

# ─── App Configuration ───────────────────────────────────────
APP_NAME=Rodeway
APP_VERSION=1.0.0+1
APP_PACKAGE_NAME=cleadr
FLUTTER_SDK_VERSION=^3.6.1
ANDROID_MIN_SDK=34

# ─── Build Configuration ─────────────────────────────────────
GITHUB_OWNER=vistaratech
GITHUB_REPO=Rodeway

# ─── Unity AR Configuration ──────────────────────────────────
UNITY_PROJECT_PATH=unity/cleadr
UNITY_SCENE=Assets/Scenes/cleadr
UNITY_VERSION=2022.2.3
UNITY_GAME_OBJECT=Flutter Unity Manager
UNITY_METHOD_NAME=Render

# ─── Debug Configuration ─────────────────────────────────────
DEBUG_MODE=true
