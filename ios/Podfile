# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get has executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Enable iOS permissions in permission_handler
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
      perm_flags = ['PERMISSION_CAMERA=1', 'PERMISSION_LOCATION=1', 'PERMISSION_BLUETOOTH=1', 'PERMISSION_SENSORS=1']
      if defs.nil?
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)'] + perm_flags
      elsif defs.is_a?(Array)
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs | perm_flags
      elsif defs.is_a?(String)
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = [defs] + perm_flags
      end
    end
  end

  # Embed UnityFramework and native plugin frameworks into Runner.app bundle
  frameworks_script = File.join(installer.sandbox.target_support_files_dir('Pods-Runner'), 'Pods-Runner-frameworks.sh')
  if File.exist?(frameworks_script)
    unity_entry = %Q(\n# Embed UnityFramework & plugin frameworks\nif [ -d "${PODS_ROOT}/../UnityLibrary/UnityFramework.framework" ]; then\n  install_framework "${PODS_ROOT}/../UnityLibrary/UnityFramework.framework"\nfi\nfind "${PODS_ROOT}/../UnityLibrary/Frameworks" -name "*.framework" -type d 2>/dev/null | while read -r fw; do\n  install_framework "$fw"\ndone\n)
    content = File.read(frameworks_script)
    unless content.include?("UnityLibrary/UnityFramework.framework")
      File.open(frameworks_script, "a") { |f| f.write(unity_entry) }
    end
  end
end
